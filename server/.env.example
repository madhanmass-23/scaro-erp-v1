# =================================================================
# SCARO ERP — Backend Production Environment Configuration Template
# =================================================================

# Server & Runtime Configuration
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# CORS Allowed Origins (Comma-separated for multiple origins)
# Leave empty or set to your frontend domain in production
CORS_ORIGIN=https://erp.scarotech.in

# MariaDB Primary Database Configuration (ServerByte / MariaDB 10.11+)
MYSQL_HOST=mysql.gb.stackcp.com
MYSQL_PORT=45272
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=your_db_name

# Authentication & JWT Configuration
# Generate high-entropy 256-bit secrets (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=your_jwt_access_secret_hex_string
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
AUTH_COOKIE_NAME=scaro_refresh_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

# Storage Engine Configuration
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
STORAGE_BASE_URL=/api/v1/storage
MAX_UPLOAD_SIZE_MB=20
SIGNED_URL_EXPIRY_MINUTES=30
IMAGE_MAX_DIMENSION=1024
STORAGE_SIGNING_SECRET=your_storage_signing_secret_hex_string
